{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flash",
  "version": "0.2.0",
  "identifier": "com.flash.clipper",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "pnpm vite --port 5174 --strictPort",
    "beforeBuildCommand": "pnpm vite build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Flash",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "backgroundColor": "#0a0a0b"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
