{
  "name": "flash-site",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": ".",
    "run_worker_first": ["/c/*", "/api/*"]
  },
  "ratelimits": [{ "name": "FEEDBACK_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "routes": [
    { "pattern": "flashclipping.fyi", "custom_domain": true }
  ]
}
